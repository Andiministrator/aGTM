scenarios:
# ─────────────────────────────────────────────────────────────────────────────
# These scenarios run ONLY inside GTM's server-template "Tests" tab. This
# template lives outside the repo (tmp/, gitignored), so it is off the `bun test`
# path entirely — this block is its only safety net.
#
# What replaced what: the previous block held one scenario whose every mock and
# every assertion was commented out. It ran `runCode(mockData)` and checked
# nothing, so it passed for any behaviour at all. Its `mockData.gtm` was also an
# OBJECT while the field is a SIMPLE_TABLE (an array), so the container loop it
# was meant to exercise could never have iterated.
#
# Scope: the synchronously reachable request logic — routing, the ?id= gate, the
# client-IP guard, and the "URL Parameters" column, which is what this version
# changed. The config object is observed through setResponseBody, since that is
# where the Client writes the aGTM.f.config(...) call.
#
# The response lifecycle is mocked as no-ops on purpose: the GTM test harness
# shares the "client has returned" state ACROSS scenarios, so a real
# returnResponse() in one makes the next scenario's claimRequest() throw.
# assertApi still records the calls.
# ─────────────────────────────────────────────────────────────────────────────

- name: env from URL - the three GTM environment parameters are appended
  code: |
    const mockData = baseData('env');
    mockGet(envQuery(), '/aGTM.js', '203.0.113.9');
    runCode(mockData);
    assertThat(body).contains('"env":"&gtm_auth=ABC123xyz&gtm_preview=env-1&gtm_cookies_win=x"');

- name: env from URL - a request without them sets no env at all
  code: |
    const mockData = baseData('env');
    mockGet({id: 'GTM-XYZ123'}, '/aGTM.js', '203.0.113.9');
    runCode(mockData);
    // Not an empty string: the library appends this value verbatim to the
    // gtm.js URL, so "absent" and "empty" must not be the same code path.
    // Positive assertion on the container's EMPTY option object. A negative one
    // on '"env"' is useless here: the served library contains that string itself
    // (aGTM.f.an(aGTM.c.gtm[t],"env",...)), so it can never hold.
    assertThat(body).contains('"GTM-XYZ123":{}');

- name: all from URL - everything except the aGTM parameters id and c
  code: |
    const mockData = baseData('all');
    mockGet({id: 'GTM-XYZ123', c: 'eyJ1IjoiIn0=', gtm_auth: 'ABC', foo: 'bar'}, '/aGTM.js', '203.0.113.9');
    runCode(mockData);
    assertThat(body).contains('"env":"&gtm_auth=ABC&foo=bar"');

- name: all from URL - values are encoded, so a parameter cannot inject parameters
  code: |
    const mockData = baseData('all');
    mockGet({id: 'GTM-XYZ123', x: 'a&b=c d'}, '/aGTM.js', '203.0.113.9');
    runCode(mockData);
    assertThat(body).contains('"env":"&x=a%26b%3Dc%20d"');

- name: all from URL - a repeated parameter is reproduced in full, in order
  code: |
    // It arrives as an array. Dropping it would silently lose an env setting;
    // taking "the first one" would invent a rule the caller never agreed to.
    const mockData = baseData('all');
    mockGet({id: 'GTM-XYZ123', dup: ['1', '2'], ok: '1'}, '/aGTM.js', '203.0.113.9');
    runCode(mockData);
    assertThat(body).contains('"env":"&dup=1&dup=2&ok=1"');

- name: a variable value that looks like parameters is used verbatim
  code: |
    // There is no separate custom column: the field takes a variable, and a
    // resolved value that is none of the three options IS the parameter string.
    const mockData = baseData('gtm_auth=FIXED');
    mockGet(envQuery(), '/aGTM.js', '203.0.113.9');
    runCode(mockData);
    assertThat(body).contains('"env":"&gtm_auth=FIXED"');
    assertThat(body).doesNotContain('ABC123xyz');

- name: a leading question mark or ampersand is optional and normalised to one
  code: |
    const mockData = baseData('?a=1');
    mockGet(envQuery(), '/aGTM.js', '203.0.113.9');
    runCode(mockData);
    assertThat(body).contains('"env":"&a=1"');

- name: a value that does not look like parameters is refused, not appended
  code: |
    // It would go verbatim into the address the page loads GTM from, so a
    // variable returning a container id or a stale "yes" must not end up there.
    const mockData = baseData('yes');
    mockGet(envQuery(), '/aGTM.js', '203.0.113.9');
