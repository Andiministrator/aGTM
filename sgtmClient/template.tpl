- name: a non-string resolved value cannot break the response
  code: |
    const mockData = baseData(7);
    mockGet(envQuery(), '/aGTM.js', '203.0.113.9');
    runCode(mockData);
    // Positive assertion on the container's EMPTY option object. A negative one
    // on '"env"' is useless here: the served library contains that string itself
    // (aGTM.f.an(aGTM.c.gtm[t],"env",...)), so it can never hold.
    assertThat(body).contains('"GTM-XYZ123":{}');

- name: an empty resolved value means not configured
  code: |
    // '' is what an untouched row looks like. Appending something there would be
    // the opposite of a default.
    const mockData = baseData('');
    mockGet(envQuery(), '/aGTM.js', '203.0.113.9');
    runCode(mockData);
    // Positive assertion on the container's EMPTY option object. A negative one
    // on '"env"' is useless here: the served library contains that string itself
    // (aGTM.f.an(aGTM.c.gtm[t],"env",...)), so it can never hold.
    assertThat(body).contains('"GTM-XYZ123":{}');

- name: each container row decides for itself
  code: |
    const mockData = baseData('env');
    mockData.gtm_id_match = false;
    mockData.gtm.push({gtm_id: 'GTM-SECOND', gtm_consent: true, gtm_use: 'a=1', gtm_url: ''});
    mockGet(envQuery(), '/aGTM.js', '203.0.113.9');
    runCode(mockData);
    assertThat(body).contains('"env":"&gtm_auth=ABC123xyz&gtm_preview=env-1&gtm_cookies_win=x"');
    assertThat(body).contains('"env":"&a=1"');

- name: id matching off - every configured container is served
  code: |
    const mockData = baseData('no');
    mockData.gtm_id_match = false;
    mockData.gtm.push({gtm_id: 'GTM-SECOND', gtm_consent: true, gtm_use: 'no', gtm_url: ''});
    mockGet({id: 'GTM-XYZ123'}, '/aGTM.js', '203.0.113.9');
    runCode(mockData);
    assertThat(body).contains('GTM-XYZ123');
    assertThat(body).contains('GTM-SECOND');

- name: id matching on - only the container named in the URL is served
  code: |
    const mockData = baseData('no');
    mockData.gtm_id_match = true;
    mockData.gtm.push({gtm_id: 'GTM-SECOND', gtm_consent: true, gtm_use: 'no', gtm_url: ''});
    mockGet({id: 'GTM-XYZ123'}, '/aGTM.js', '203.0.113.9');
    runCode(mockData);
    assertThat(body).contains('GTM-XYZ123');
    assertThat(body).doesNotContain('GTM-SECOND');

- name: an id that is not configured at all is refused before the request is claimed
  code: |
    const mockData = baseData('no');
    mockGet({id: 'GTM-NOPE'}, '/aGTM.js', '203.0.113.9');
    runCode(mockData);
    assertApi('claimRequest').wasNotCalled();

- name: a non-matching route produces no response
  code: |
    const mockData = baseData('no');
    mockGet({id: 'GTM-XYZ123'}, '/somethingelse.js', '203.0.113.9');
    runCode(mockData);
    assertApi('claimRequest').wasNotCalled();
    assertApi('setResponseBody').wasNotCalled();

- name: no client IP configured - 403 and no library
  code: |
    const mockData = baseData('no');
    mockData.client_ip = '';
    mockGet(envQuery(), '/aGTM.js', '203.0.113.9');
    runCode(mockData);
    assertApi('setResponseStatus').wasCalledWith(403);
    // The blocked visitor must not receive the library. Before the return was
    // added the Client wrote it as a second response right after deciding 403.
    assertThat(body).doesNotContain('aGTM.f.config');
    assertThat(body).contains('blocked IP address');
setup: |-
  // ── Test helpers (shared, re-run before every scenario) ────────────────────
  const JSON = require('JSON');

  // Whatever the Client wrote as the response body, for the scenarios that need
  // to look at the injected aGTM.f.config(...) call. Reset by mockGet().
  let body = '';
  let returned = false;

  // Fresh template `mockData` per scenario. `data` is a bound sandbox global, so
  // the local MUST be named something else.
  // `gtm` is an ARRAY — it is a SIMPLE_TABLE. The previous block had it as an
  // object, which is why its container loop could never have run.
  const baseData = function(useMode) {
    return {
      gtm: [{gtm_id: 'GTM-XYZ123', gtm_consent: true, gtm_use: useMode, gtm_url: ''}],
      gtm_id_match: false,
      cmp: null,
      client_ip: '203.0.113.9',
      botCheckEnabled: false,
      botCheck: '',
      consent: [],
      ck_consent: [],
      sendConsentEvent: true,
      useListener: false,
      consent_events: 'cmpEvent,cmpUpdate',
      aPageview: false,
      vPageview: false,
      vPageviews: false,
      dlStateEvents: false,
      gdl: '',
      dlOrgPush: '',
      nonce: 'ABC123',
      debug: false
    };
  };

  // The query string of the documented env example, so scenarios that must NOT
  // pick it up are tested against a request that actually carries it.
  const envQuery = function() {
    return {id: 'GTM-XYZ123', gtm_auth: 'ABC123xyz', gtm_preview: 'env-1', gtm_cookies_win: 'x'};
  };

  // Mock a browser → Client GET. The response lifecycle is mocked as no-ops:
  // the GTM test harness shares the "client has returned" state across
  // scenarios, so a real returnResponse() in one makes the next scenario's
  // claimRequest() throw. assertApi still records every call.
  const mockGet = function(query, path, remoteAddr) {
    body = '';
    returned = false;
    mock('getRequestPath', function() { return path; });
    mock('getRequestMethod', function() { return 'GET'; });
    mock('getRequestQueryParameters', function() { return query; });
    mock('getRequestHeader', function() { return ''; });
    mock('getRemoteAddress', function() { return remoteAddr; });
    mock('getCookieValues', function() { return []; });
    mock('getTimestampMillis', function() { return 1714900000000; });
    mock('claimRequest', function() {});
    // After returnResponse() the response is on the wire and later writes are
    // moot. Modelling that is not decoration: without it the harness records a
    // body that the visitor never receives, and a blocked request looks served.
    mock('returnResponse', function() { returned = true; });
    mock('setResponseStatus', function() {});
    mock('setResponseHeader', function() {});
    mock('setResponseBody', function(b) { if (!returned) body = b; });
  };



