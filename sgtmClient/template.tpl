const setResponseBody = require('setResponseBody');
const returnResponse = require('returnResponse');
const getRequestPath = require('getRequestPath');
const getRequestQueryParameters = require('getRequestQueryParameters');
const sendHttpGet = require('sendHttpGet');
const getRequestHeader = require('getRequestHeader');
const fromBase64 = require('fromBase64');
const toBase64 = require('toBase64');
const JSON = require('JSON');
const Object = require('Object');
const encodeUriComponent = require('encodeUriComponent');
const logToConsole = require('logToConsole');

// Check for /aGTM.js Path
const rpath = getRequestPath();
//logToConsole('debug', 'aGTM Path: ',rpath);
if (rpath.length < 8 || rpath.slice(rpath.length - 8) !== '/aGTM.js') return;
//if (getRequestPath() !== '/aGTM.js') return;
// Get URL Request Parameters and id
const queryParameters = getRequestQueryParameters();
const id = queryParameters.id || null;

// URL parameters that may be appended to the GTM container URL.
// The library appends this string VERBATIM to the gtm.js URL
// (...gtm.js?id=GTM-X&l=dataLayer<env>), so it has to start with "&".
// Built once per request here; the container table decides per row which
// variant (env / all / custom) is used - see "URL Parameters" column.
const MAX_REPEATS = 10;   // bounds the WORK, not just the output
const MAX_PARAM_LEN = 1000; // total budget for one container's parameter string
const buildParam = function(k, v) {
  if (typeof k != 'string' || !k) return '';
  if (typeof v == 'string') {
    if (!v) return '';
    return '&' + encodeUriComponent(k) + '=' + encodeUriComponent(v);
  }
  // A repeated parameter (?a=1&a=2) arrives as an ARRAY of values, not a string.
  // Every value is reproduced in order, which is the only answer that is not a
  // guess: it hands GTM exactly the query string the caller sent. Dropping the
  // parameter would silently lose an env setting; taking "the first one" would
  // invent a rule the caller never agreed to. The string check has to come
  // first - a string has a numeric .length too, and the sandbox has no
  // Array.isArray to tell them apart.
  if (typeof v != 'object' || !v || typeof v.length != 'number') return '';
  const n = v.length > MAX_REPEATS ? MAX_REPEATS : v.length;
  // Caller-driven too - see the note on the length cap below.
  if (v.length > MAX_REPEATS) logToConsole('debug', '✗ URL parameter repeated more than ' + MAX_REPEATS + ' times, rest dropped', k);
  let outv = '';
  for (let ri = 0; ri < n; ri++) {
    if (typeof v[ri] == 'string' && v[ri]) outv = outv + '&' + encodeUriComponent(k) + '=' + encodeUriComponent(v[ri]);
  }
  return outv;
};
// Parameters aGTM owns and never forwards: "id" selects the container, "c"
// carries the base64 page payload, and "l" names the dataLayer - the library
// sets that one itself, so a caller's copy could only redirect GTM onto a
// dataLayer nobody writes to (a silent total measurement outage).
const ownParam = function(k) { return k == 'id' || k == 'c' || k == 'l'; };
// Appends `piece` while keeping the total under MAX_PARAM_LEN, checked BEFORE
// appending: a parameter is either fully there or not at all. Truncating in the
// middle would produce a valid-looking but wrong URL. Returns null when it did
// not fit, so callers can report WHICH parameter was lost, not just how many.
const addParam = function(str, piece) {
  if (!piece) return str;
  if (str.length + piece.length > MAX_PARAM_LEN) return null;
  return str + piece;
};
// "env": the three parameters GTM itself defines for environments.
const ENV_KEYS = ['gtm_auth', 'gtm_preview', 'gtm_cookies_win'];
let envParams = '';
let envOverflow = false;
for (const ek of ENV_KEYS) {
  const fit = addParam(envParams, buildParam(ek, queryParameters[ek]));
  if (fit === null) envOverflow = true;
  else envParams = fit;
}
// The three are an ATOMIC set: an environment request carrying gtm_preview but
// not gtm_auth is not a partial success, it is a request GTM answers with a
// stub. 'debug' for the same reason as the "all" cap: with the page query
// forwarded, any caller can trigger it.
if (envOverflow) {
  envParams = '';
  logToConsole('debug', '✗ env parameters exceed ' + MAX_PARAM_LEN + ' chars - none applied (the set is atomic)');
}
// "all": every query parameter except the ones aGTM owns - but the env
// parameters FIRST. Order decides what survives the budget, and it used to be
// the order of the request URL: a landing page carrying gclid/_gl/utm_* ahead
// of gtm_auth could push out exactly the parameter the column exists for,
// leaving an environment request without its auth. GTM answers that with a
// stub, so GTM would fail to load for those visitors only.
let allParams = envParams;
let allDropped = [];
const qpKeys = Object.keys(queryParameters);
for (const qk of qpKeys) {
  if (!ownParam(qk) && ENV_KEYS.indexOf(qk) < 0) {
    const fit = addParam(allParams, buildParam(qk, queryParameters[qk]));
    if (fit === null) allDropped.push(qk);
    else allParams = fit;
  }
}
// Caller-driven, so 'debug': with the page query forwarded to /aGTM.js anyone
// can trigger it on every request. At 'warn' it would drown the one line that
// means "your setup is broken", which stays at 'warn' below.
if (allDropped.length > 0) logToConsole('debug', '✗ URL parameters exceed ' + MAX_PARAM_LEN + ' chars, dropped: ' + allDropped.join(','));
// Anything else: the column's own resolved value, taken verbatim - tenant-
// authored configuration, same trust level as the container URL itself. Only a
// leading "?"/"&" is normalised away. Only a STRING can be a parameter string:
// a variable may hand us a number, a boolean or an object, none of which belong
// in a URL.
const normParams = function(str) {
  if (typeof str != 'string') return '';
  let t = str;
  while (t.length > 0 && (t.charAt(0) == '?' || t.charAt(0) == '&')) { t = t.slice(1); }
  if (!t) return '';
  return '&' + t;
};
// Does a verbatim parameter string try to set a parameter aGTM owns? The column
// takes a VARIABLE, and the README teaches deriving a variable from the request
// URL two columns further up - so this value can be caller-influenced even
// though it is meant to be tenant-authored. Refusing "id" and "l" here means the
// result does not depend on how a given /gtm.js resolves duplicate parameters.
const claimsOwnParam = function(str) {
  const parts = str.split('&');
  for (const pt of parts) {
    const eq = pt.indexOf('=');
    const key = eq < 0 ? pt : pt.slice(0, eq);
    if (ownParam(key)) return true;
    // A percent-escape in the KEY defeats a raw-name comparison: "%69d=" and
    // "%6C=" reach the receiving server as "id=" and "l=". Any key carrying a
    // "%" is refused - a legitimate GTM parameter name never contains one.
    if (key.indexOf('%') >= 0) return true;
  }
  return false;
};
if (!data.gtm) { logToConsole('warn', '✗ No GTM Container configured'); /*return;*/ }
// Return if id is set but not allowed
if (id && data.gtm) {
  let id_allowed = false;
  for (const val of data.gtm) {
    if (val.gtm_id===id) {
      id_allowed = true;
      break;
    }
  }
  if (!id_allowed) { logToConsole('warn', '✗ No matching GTM ID', id); return; }
}
// Claim Request
claimRequest();

// Build CMP Code
let cmp = data.cmp ? data.cmp : "";
if (!cmp && data.cmp_custom_active) {
  cmp = data.cmp_custom_code;
}

// Build aGTM Config
const c = {};
// Build gtm object
if (data.gtm) {
  var gtm_id_match = typeof data.gtm_id_match=='boolean' ? data.gtm_id_match : false;
  const qp_id = typeof id=='string' ? id : '';
  const gtm = {};
  for (const val of data.gtm) {
    if (val.gtm_id && (!gtm_id_match || val.gtm_id==qp_id)) {
      gtm[val.gtm_id] = {};
      if (!val.gtm_consent) gtm[val.gtm_id].noConsent = true;
      // The column is named gtm_use - reading val.gtm_env meant reading a column
      // that does not exist, so env was NEVER set and the switch did nothing
      // (since e8a8207, 2025-09-24). A stored boolean true is the old "yes" and
      // keeps meaning the env parameters.
      // The column accepts a VARIABLE, so this value is not limited to the three
      // listed options - it is whatever the variable resolved to at request
      // time. Anything else IS the parameter string: one field carries both the
      // choice and, when it is neither of the three, the value. That is why
      // there is no second column.
      //
      // An UNSET column is deliberately not a parameter string: '' / undefined /
      // false is what an untouched row looks like, and appending something to
      // rows nobody configured would be the opposite of a default.
      let envStr = '';
      const mode = val.gtm_use;
      if (mode === 'env' || mode === true) {
        envStr = envParams;
        // The most common first-setup mistake: the column is set, but the
        // integration snippet does not carry the parameters. Every other failure
        // in here leaves a trace; this one used to be the silent one, and it is
        // the likeliest. 'debug', not 'warn' - parameters that appear only
        // sometimes are a legitimate setup.
        if (!envStr) logToConsole('debug', '✗ URL Parameters is "env" but the request carries none of ' + ENV_KEYS.join('/'));
      }
      else if (mode === 'all') envStr = allParams;
      else if (mode !== 'no' && mode !== false && mode !== '' && typeof mode != 'undefined' && mode !== null) {
        // A resolved value only counts as a parameter string if it LOOKS like
        // one - it goes verbatim into the address the page loads GTM from, so a
        // variable returning a container id, a stale "yes" or an error message
        // must not end up there. "> 1", not "> 0": cand starts with the "&" that
        // normParams prepends, so an "=" at index 1 is a parameter with an EMPTY
        // name ("&=value"). The rejection is logged - a renamed variable would
        // otherwise change which environment a container loads silently.
        // Same budget as the request-derived paths - it ends up in the same URL.
        const cand = normParams(mode);
        if (!cand || cand.indexOf('=') < 2) logToConsole('warn', '✗ URL Parameters is neither no/env/all nor a k=v parameter string, ignored', mode);
        else if (cand.length > MAX_PARAM_LEN) logToConsole('warn', '✗ URL Parameters value exceeds ' + MAX_PARAM_LEN + ' chars, ignored');
        else if (claimsOwnParam(cand)) logToConsole('warn', '✗ URL Parameters must not set id, c or l - ignored', mode);
        else envStr = cand;
      }
      if (envStr) gtm[val.gtm_id].env = envStr;
      if (val.gtm_url) gtm[val.gtm_id].gtmURL = val.gtm_url;
    }
  }
  c.gtm = gtm;
}
// Add Consent Conditions
if (data.consent) {
  for (const val of data.consent) {
    c[val.consent_type] = val.consent_value;
  }
}
// Add Additional Consent Conditions for the ck URL parameter in the GTM Request URL
if (data.ck_consent) {
  for (const val2 of data.ck_consent) {
    c[val2.ck_consent_type] = val2.ck_consent_value;
  }
}
// Add other Consent Options
if (data.sendConsentEvent) c.sendConsentEvent = true;
if (data.useListener) c.useListener = true;
if (data.consent_events) c.consent_events = data.consent_events;
// Other Options
if (data.aPageview) c.aPageview = true;
if (data.vPageview) c.vPageview = true; // deprecated
if (data.vPageviews) c.vPageviews = true;
if (data.dlStateEvents) c.dlStateEvents = true;
if (data.gdl) c.gdl = data.gdl;
if (data.dlOrgPush) c.dlOrgPush = data.dlOrgPush; if (typeof c.dlOrgPush!='string' || c.dlOrgPush=='-') c.dlOrgPush = '';
if (data.nonce) c.nonce = data.nonce;
if (data.debug) c.debug = true;
// Build config string
const config = "aGTM.f.config(" + JSON.stringify(c) + ");";
logToConsole('info', '✓ aGTM Configuration', c);

// aGTM Code
const agtm = fromBase64('');

// Build JS Code for response
var jsCode = agtm + cmp + config + 'aGTM.f.init();';

// Function to send the aGTM Code
const sendCode = function (status,code) {
  setResponseStatus(status);
  setResponseHeader('x-agtm-version', aGTMversion);
  setResponseHeader('Cache-Control', 'no-cache, no-store, must-revalidate');
  setResponseHeader('Pragma', 'no-cache');
  setResponseHeader('Expires', '0');
  setResponseHeader('Content-Type', 'text/javascript; charset=utf-8');
  const origin = getRequestHeader('Origin') || null;
  if (origin) {
    setResponseHeader('Access-Control-Allow-Origin', origin);
    setResponseHeader('Access-Control-Allow-Credentials', 'true');
    setResponseHeader('Access-Control-Max-Age', '86400');
  }
  setResponseBody(code);
  returnResponse();
};

// Bot Check
var boturl = data.botCheck;
var botCheckEnabled = typeof data.botCheckEnabled=='boolean' ? data.botCheckEnabled : false;
const clientIP = typeof data.client_ip=='string' ? data.client_ip : '';
if (clientIP=='') {
  logToConsole('error', '✗ Invalid, missing or bad IP Address', data.client_ip);
  sendCode(403,fromBase64('Y29uc29sZS5lcnJvcignYUdUTSBFcnJvcjogSW52YWxpZCBvciBibG9ja2VkIElQIGFkZHJlc3MnKTs='));
  // The response is decided here. Without this return the Client walked on and
  // sent the full library as a second response; returnResponse() made that moot
  // on the wire, so it never showed - but the work happened, and a blocked
  // request could not be observed as blocked.
  return;
}
const userAgent = getRequestHeader('User-Agent');
//const userAgent = 'curl';
if (!botCheckEnabled || !boturl) {
  sendCode(200,jsCode);
} else {
  // Build Object for payload
  const plObj = {
    UserAgent: userAgent,
    ClientIP: clientIP
  };
  // Enrich boturl
  boturl += '/' + toBase64(JSON.stringify(plObj));
  logToConsole('info', '✓ API Service Call', plObj);
  // Use Service
  sendHttpGet(boturl, {
    timeout: 5000,
  }).then(function(result) {
    logToConsole('info', '✓ API Service active (' + result.statusCode + ')', result.body);
    var isBot = false;
    if (typeof result.body=='string' && result.body) {
      var resObj = JSON.parse(result.body);
      if (typeof resObj=='object' && resObj.isBot) isBot = true;
    }
    if (isBot) {
      logToConsole('warn', '✗ Bot recognized', userAgent);
      setResponseStatus(403);
      //setResponseBody('You are a bad bot!');
      returnResponse();
    } else {
      sendCode(200,jsCode);
    }
  }, function(error) {
    logToConsole('error', '✗ API Service Problem', error);
  });
}

